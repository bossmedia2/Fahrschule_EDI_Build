# ============================================================
# KOMPLETTSPERRE (z. B. Staging-/Testumgebung)
# ------------------------------------------------------------
# Variante A – ohne Datei: in wp-config.php eintragen
#   define( 'FAHRSCHULE_BLOCK_ALL_BOTS', true );
#
# Variante B – mit dieser Datei: alle Zeilen oben löschen und
# stattdessen nur die folgenden zwei Zeilen aktiv lassen:
#   User-agent: *
#   Disallow: /
#
# Wichtig: robots.txt verhindert das Crawlen, nicht zwingend die
# Indexierung verlinkter URLs. Für echte Nicht-Indexierung zusätzlich
# unter Einstellungen -> Lesen die Sichtbarkeit deaktivieren
# (setzt noindex-Header) oder HTTP-Basic-Auth verwenden.
# ============================================================
